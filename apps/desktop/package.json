{
  "name": "@opencalque/desktop",
  "productName": "AxioDraw",
  "version": "1.10.4",
  "private": true,
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/preload",
    "smoke": "electron scripts/smoke.cjs",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "@opencalque/cli": "workspace:*",
    "@opencalque/warehouse": "workspace:*",
    "@opencalque/web": "workspace:*",
    "@vitejs/plugin-react": "^5",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "electron-vite": "^5.0.0",
    "vite": "^7"
  },
  "description": "Open-source 2D architectural editor: floor plans and layouts.",
  "author": "OpenCalque contributors",
  "homepage": "https://github.com/dyarc/opencalque",
  "build": {
    "appId": "com.axiodraw.app",
    "productName": "AxioDraw",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../../THIRD-PARTY-NOTICES.txt",
        "to": "THIRD-PARTY-NOTICES.txt"
      },
      {
        "from": "build/adg-icon.rsrc",
        "to": "adg-icon.rsrc"
      },
      {
        "from": "build/document.icns",
        "to": "document.icns"
      }
    ],
    "npmRebuild": false,
    "publish": {
      "provider": "github",
      "owner": "dyarc",
      "repo": "opencalque"
    },
    "fileAssociations": [
      {
        "ext": "adg",
        "name": "AxioDraw drawing",
        "role": "Editor"
      },
      {
        "ext": "opencalque",
        "name": "AxioDraw drawing (old name)",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AxioDraw-${version}-windows-setup.${ext}"
    },
    "portable": {
      "artifactName": "AxioDraw-${version}-windows-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null,
      "category": "public.app-category.graphics-design",
      "artifactName": "AxioDraw-${version}-mac-${arch}.${ext}",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "AxioDraw drawing",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "CFBundleTypeExtensions": [
              "adg"
            ],
            "CFBundleTypeIconFile": "document.icns"
          },
          {
            "CFBundleTypeName": "AxioDraw drawing (old name)",
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "CFBundleTypeExtensions": [
              "opencalque",
              "opencad"
            ],
            "CFBundleTypeIconFile": "document.icns"
          }
        ]
      }
    },
    "linux": {
      "target": "AppImage",
      "category": "Graphics",
      "executableName": "opencalque",
      "artifactName": "AxioDraw-${version}-linux-${arch}.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
